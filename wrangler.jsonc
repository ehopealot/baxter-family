{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baxter-family",
	"main": "src/index.js",
	"compatibility_date": "2026-08-05",

	"assets": {
		// The site is the repo root. `.assetsignore` keeps the things that
		// aren't the site — this config, the schema, tools, the Worker source —
		// from being uploaded and served.
		"directory": ".",
		"binding": "ASSETS",
		// "none" (not "404-page") so a path with no matching asset falls through to the Worker
		// instead of being 404'd at the edge. The Worker turns a bare invite code (/PNW1, a
		// bax.bot/<CODE> card link) into the /?code= entry point, and serves 404.html for
		// everything else (see src/index.js) -- so unknown paths still get the real 404 page.
		"not_found_handling": "none",
		// The Worker runs first for /api/*, and (via not_found_handling above) for any path with
		// no matching asset. A real asset -- the pages, css, js, images -- is still served off the
		// edge without invoking it.
		"run_worker_first": ["/api/*"]
	},

	// One binding, named DB because that's what the handlers read: env.DB.
	// `wrangler d1 create` appends its own block using the database name as the
	// binding — delete that if it turns up again rather than ending up with two
	// bindings onto the same database.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "baxter-family",
			"database_id": "53525086-7fe9-4b90-ade4-09cef82f0687"
		}
	],

	// GET /api/invite answers "is this code good?" for anyone who asks, and
	// codes are only four characters, so the endpoint is a guessing oracle
	// unless it is throttled. Four a minute per IP: a person typing a code off a
	// card gets it right first or second go, and a scan gets nowhere.
	//
	// namespace_id is just a label; it needs to be unique among this Worker's
	// limiters, not registered anywhere. period only accepts 10 or 60.
	"ratelimits": [
		{
			"name": "INVITE_CHECK",
			"namespace_id": "1001",
			"simple": { "limit": 4, "period": 60 }
		}
	]

	// TURNSTILE_SECRET is a secret, not a var — never put it here:
	//   wrangler secret put TURNSTILE_SECRET
	// and for local dev, a .dev.vars file (gitignored).
}
